#!name=SenPlayer AV番号字幕
#!desc=SenPlayer 搜字幕时，番号关键词改走迅雷字幕源（伪装成 assrt 响应）；非番号关键词放行，不影响正常影片。
#!author=Muse
#!icon=https://raw.githubusercontent.com/Loon0x00/loon/main/icon.png
#!homepage=https://nsloon.app

# 安装前必读（详见 README.md）：
# 1. 把 loon/avsub-assrt-shim.js 托管到可公开访问的 URL（如 GitHub Gist 的 Raw 地址），
#    将下面唯一的 SCRIPT_URL 替换为该地址；
# 2. LOON 内导入本插件，并确认已安装信任 LOON CA（抓包能看到 api.assrt.net 明文即已就绪）；
# 3. 前置条件：Emby 里该影片的标题须包含番号（SenPlayer 是拿标题当关键词去搜的），
#    否则脚本识别不到番号会直接放行。
#
# v2.0（2026-11-21）：改为单条规则匹配 /v1/sub/*（搜索+详情），不再用两条规则共用
# 同一脚本——v1.0 实测中详情请求未被拦截，assrt 返回 subtitle not found，
# SenPlayer 报“字幕下载失败”。单规则排除详情规则未生效的可能；
# 脚本内另有双写映射 + 兜底 + 全链路日志（LOON 脚本日志搜 [AVSub] 可查）。

[Script]
http-response ^https://api\.assrt\.net/v1/sub/ script-path=https://raw.githubusercontent.com/zhuangef/mono/refs/heads/master/avsub-assrt-shim.js, requires-body=true, timeout=15, tag=AVSub-Shim

[MITM]
hostname = api.assrt.net
